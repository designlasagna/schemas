    "./v0.2/utilities.json": "./v0.2/utilities.json",
    "./v0.2/cem-extensions.json": "./v0.2/cem-extensions.json",
    "./v0.3/tokens.json": "./v0.3/tokens.json",
    "./v0.3/utilities.json": "./v0.3/utilities.json",
    "./v0.3/icons.json": "./v0.3/icons.json",
    "./v0.3/cem-extensions.json": "./v0.3/cem-extensions.json",
    "./v0.3/dtcg-extensions.json": "./v0.3/dtcg-extensions.json",
    "./examples/*": "./examples/*",
    "./package.json": "./package.json"
  },
  "files": [
    "v0.2/",
    "v0.3/",
    "examples/"
