  "description": "JSON schemas for design system manifests — tokens, utilities, icons, CEM extensions, and DTCG authoring extensions. Multi-platform.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/designlasagna/schemas"
  },
  "homepage": "https://designlasagna.recipes",
  "keywords": [
    "design-system",
    "design-tokens",
